{
  "name": "quietbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ctd/sdk": "workspace:*",
    "@stellar/stellar-sdk": "^14.2.0"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap-upstream.sh",
    "build:sdk": "pnpm --filter @ctd/sdk build && pnpm --filter @quietbook/sdk build",
    "build:confidential-keys": "pnpm --filter @quietbook/sdk build:confidential-keys",
    "build:max-bid-key": "pnpm --filter @quietbook/sdk build:max-bid-key",
    "deploy:testnet": "pnpm --filter @quietbook/sdk exec tsx ../../scripts/deploy-testnet.ts",
    "smoke:testnet": "pnpm --filter @quietbook/sdk exec tsx ../../scripts/smoke-testnet.ts",
    "smoke:controller:testnet": "pnpm --filter @quietbook/sdk exec tsx ../../scripts/smoke-controller-testnet.ts",
    "setup:round:testnet": "pnpm --filter @quietbook/sdk exec tsx ../../scripts/setup-round-testnet.ts",
    "settle:round:testnet": "pnpm --filter @quietbook/sdk exec tsx ../../scripts/settle-round-testnet.ts",
    "reclaim:round:testnet": "pnpm --filter @quietbook/sdk exec tsx ../../scripts/reclaim-round-testnet.ts",
    "smoke:withdrawal:testnet": "pnpm --filter @quietbook/sdk exec tsx ../../scripts/smoke-withdrawal-testnet.ts",
    "audit:round:testnet": "pnpm --filter @quietbook/sdk exec tsx ../../scripts/audit-round-testnet.ts",
    "disclose:settlement:testnet": "pnpm --filter @quietbook/sdk exec tsx ../../scripts/disclose-settlement-testnet.ts",
    "dev:web": "pnpm build:sdk && pnpm --filter @quietbook/web dev",
    "dev:indexer": "pnpm --filter @quietbook/indexer dev",
    "judge": "pnpm build:sdk && VITE_INDEXER_URL=http://127.0.0.1:8787 pnpm --parallel --filter @quietbook/indexer --filter @quietbook/web run dev",
    "sync:indexer": "pnpm --filter @quietbook/indexer sync",
    "build:indexer": "pnpm --filter @quietbook/indexer build",
    "test:indexer": "pnpm --filter @quietbook/indexer test",
    "build:web": "pnpm build:sdk && pnpm --filter @quietbook/web build",
    "test:web": "pnpm --filter @quietbook/web test:e2e",
    "test": "pnpm test:contracts && pnpm test:circuits && pnpm build:sdk && pnpm test:sdk && pnpm test:proof && pnpm test:indexer && pnpm test:privacy && pnpm --filter @quietbook/web build && pnpm test:web",
    "test:contracts": "cargo test --manifest-path contracts/Cargo.toml",
    "test:circuits": "cd circuits/max_bid && ../../.tools/noir/nargo test && cd ../disclose_settlement && ../../.tools/noir/nargo test",
    "test:sdk": "pnpm --filter @quietbook/sdk test",
    "test:proof": "pnpm --filter @quietbook/sdk test:proof",
    "test:privacy": "pnpm --filter @quietbook/sdk exec tsx ../../scripts/check-public-privacy.ts"
  }
}
