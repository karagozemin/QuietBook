{
  "name": "@quietbook/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./product": {
      "types": "./dist/product.d.ts",
      "import": "./dist/product.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js"
    },
    "./disclosure": {
      "types": "./dist/disclosure.d.ts",
      "import": "./dist/disclosure.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:confidential-keys": "tsx scripts/build-confidential-keys.ts",
    "build:max-bid-key": "tsx scripts/build-max-bid.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx test/spender.test.ts && tsx test/product.test.ts && tsx test/audit.test.ts",
    "test:proof": "tsx test/proof.test.ts"
  },
  "dependencies": {
    "@ctd/sdk": "workspace:*",
    "@stellar/stellar-sdk": "^14.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
