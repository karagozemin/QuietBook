{$QUIETBOOK_API_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  reverse_proxy indexer:8787 {
    health_uri /ready
    health_interval 30s
    health_timeout 5s
  }

  log {
    output stdout
    format json
  }
}
