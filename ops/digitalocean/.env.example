# Public DNS name that points to the Droplet. Do not include https:// here.
QUIETBOOK_API_DOMAIN=api.example.com

# Exact frontend origins, comma-separated and without trailing slashes.
QUIETBOOK_ALLOWED_ORIGINS=https://example.vercel.app

# Stable token audience, normally the public backend HTTPS origin.
QUIETBOOK_AUTH_AUDIENCE=https://api.example.com

# Generate with: openssl rand -hex 32
QUIETBOOK_SESSION_SECRET=replace-with-at-least-32-random-characters

# Testnet-only role secrets. Never commit or bake these into the image.
QUIETBOOK_DEPLOYER_SECRET=S...
QUIETBOOK_ISSUER_SECRET=S...
QUIETBOOK_OPERATOR_SECRET=S...

# Immutable release identifier, normally a Git commit SHA.
QUIETBOOK_IMAGE_TAG=latest
